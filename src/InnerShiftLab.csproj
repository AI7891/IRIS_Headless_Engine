<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InnerShiftLab</RootNamespace>
    <AssemblyName>InnerShiftLab</AssemblyName>
    <!-- Single-file publish for phone deploy -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64</RuntimeIdentifiers>
    <!-- Trimmed for smaller payload -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.35.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
    <PackageReference Include="QuestPDF" Version="2024.7.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.69.0.3674" />
    <PackageReference Include="Google.Apis.Auth" Version="1.69.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal static helpers (e.g. GitOutboxExporter's retention/URL logic) to the test project. -->
    <InternalsVisibleTo Include="InnerShiftLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data files live at the repo root (one level up from this project). Copy them
         next to the built binary so the app is self-contained wherever it is run. -->
    <None Include="..\hooks.json" CopyToOutputDirectory="PreserveNewest" Link="hooks.json" />
    <None Include="..\pillars.json" CopyToOutputDirectory="PreserveNewest" Link="pillars.json" />
    <None Include="..\appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" />
  </ItemGroup>

</Project>

